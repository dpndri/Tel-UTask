# ==============================================================
# Tel-UTask Environment Variables
# Salin file ini menjadi .env.local untuk local development
# dan masukkan variabel ini ke Project Settings -> Environment Variables di Vercel
# ==============================================================

# Supabase (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opsional: URL Kalender Contoh CeLOE (Jika ingin override)
# CELOE_SAMPLE_URL=https://lms.telkomuniversity.ac.id/calendar/export_execute.php?...
